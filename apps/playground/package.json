{
  "name": "@onlyoffice-local/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --base=/oolocal/",
    "build": "tsc -p tsconfig.json --noEmit && vite build --base=/oolocal/",
