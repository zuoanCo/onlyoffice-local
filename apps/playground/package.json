    "build:root": "tsc -p tsconfig.json --noEmit && vite build --base=/"
  },
  "dependencies": {
    "@onlyoffice-local/vanilla": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "@types/node": "^22.9.0"
  }
}
