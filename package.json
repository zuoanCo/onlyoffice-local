{
  "name": "onlyoffice-local-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Framework-agnostic, purely local OnlyOffice editing for the browser. Core SDK plus adapters for Vue 2/3, React, Angular and vanilla JS.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=18" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "demo": "npm run dev -w @onlyoffice-local/playground"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
